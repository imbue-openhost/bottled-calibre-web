#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# Auth-proxy sidecar for Calibre-Web. Reads the X-OpenHost-Is-Owner header
# the OpenHost router stamps on requests carrying a valid owner session,
# and stamps X-Openhost-User: admin on the proxied request when it is
# true. Calibre-Web, configured with config_allow_reverse_proxy_header_login
# = 1 and a header name of X-Openhost-User, treats that as an authenticated
# session for the admin user. Non-owner traffic falls through to
# Calibre-Web's normal username/password login.
#
# We run on 0.0.0.0:8080 (the openhost.toml-declared port that the
# OpenHost router talks to) and forward to Calibre-Web on 127.0.0.1:8083
# (Calibre-Web's LSIO default, which we leave untouched so its s6
# readiness probe `nc -z localhost 8083` continues to work). Calibre-Web
# binds *:8083 inside the container, but the OpenHost router only
# routes traffic to the manifest-declared port 8080, so external
# traffic must traverse this sidecar to reach Calibre-Web.
#
# The proxy is pure Python stdlib (no third-party deps), so we run it with
# the system python3 that ships in the LSIO base image.
exec python3 /app/auth_proxy.py
